<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="14dp"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="22sp"/>

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reservation"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvItemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unsold Bread Loaves"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvStatus"
                style="@style/ChipText"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_reserved"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Reserved"
                android:textSize="12sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:background="@color/divider"/>

            <TextView style="@style/InfoLabel" android:text="Quantity"/>
            <TextView android:id="@+id/tvQuantity" style="@style/InfoValue" android:text="10 loaves"/>

            <TextView style="@style/InfoLabel" android:text="Pick Up From"/>
            <TextView android:id="@+id/tvPickupFrom" style="@style/InfoValue" android:text="Sweet Crumb Bakery"/>

            <TextView android:id="@+id/labelDeliverTo" style="@style/InfoLabel" android:text="Deliver To"/>
            <TextView android:id="@+id/tvDeliverTo" style="@style/InfoValue" android:text="Rumah Amal Harapan"/>

            <TextView style="@style/InfoLabel" android:text="Volunteer Collector"/>
            <TextView android:id="@+id/tvVolunteer" style="@style/InfoValue" android:text="Not assigned yet"/>

            <TextView style="@style/InfoLabel" android:text="Scheduled Pickup"/>
            <TextView android:id="@+id/tvScheduled" style="@style/InfoValue" android:text="Today, 8:30 PM"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:text="Status Timeline"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/llTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp"/>

            <TextView
                android:id="@+id/btnPrimary"
                style="@style/PrimaryButton"
                android:layout_marginBottom="12dp"
                android:text="Action"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/btnSecondary"
                style="@style/SecondaryButton"
                android:layout_marginBottom="12dp"
                android:text="Reschedule Pickup"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/btnDanger"
                style="@style/DangerButton"
                android:layout_marginBottom="12dp"
                android:text="Cancel Reservation"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
