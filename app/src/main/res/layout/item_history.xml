<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHistoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Unsold Bread Loaves"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvHistoryStatus"
            style="@style/ChipText"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_delivered"
            android:text="Delivered"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistoryMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Reservation #R-1042 · 24 Sep, 8:45 PM"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/tvHistorySub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Sweet Crumb Bakery → Rumah Amal Harapan"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"/>

</LinearLayout>
