<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="New Food Listing"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Share your surplus food with the community"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>

        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_food_placeholder"
            android:clickable="true"
            android:contentDescription="Food photo"
            android:focusable="true"
            android:scaleType="center"
            android:src="@drawable/ic_food"/>

        <TextView
            android:id="@+id/btnAddPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="+ Add Photo"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView style="@style/FieldLabel" android:text="Food Title"/>
        <EditText
            android:id="@+id/etTitle"
            style="@style/InputField"
            android:hint="e.g. Unsold bread loaves"
            android:inputType="textCapSentences"
            android:maxLength="60"/>

        <TextView style="@style/FieldLabel" android:text="Category"/>
        <Spinner
            android:id="@+id/spinnerCategory"
            style="@style/InputField"
            android:paddingStart="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/FieldLabel" android:text="Quantity"/>
                <EditText
                    android:id="@+id/etQuantity"
                    style="@style/InputField"
                    android:hint="e.g. 10"
                    android:inputType="number"
                    android:maxLength="4"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/FieldLabel" android:text="Unit"/>
                <EditText
                    android:id="@+id/etUnit"
                    style="@style/InputField"
                    android:hint="e.g. loaves"
                    android:inputType="text"
                    android:maxLength="20"/>
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/FieldLabel" android:text="Pickup Location"/>
        <EditText
            android:id="@+id/etLocation"
            style="@style/InputField"
            android:hint="e.g. 12, Jalan Bahagia"
            android:inputType="textPostalAddress|textCapWords"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/FieldLabel" android:text="Area"/>
                <Spinner
                    android:id="@+id/spinnerArea"
                    style="@style/InputField"
                    android:paddingStart="6dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/FieldLabel" android:text="Pickup Deadline"/>
                <TextView
                    android:id="@+id/tvPickDeadline"
                    style="@style/InputField"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="Select time"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/FieldLabel" android:text="Description"/>
        <EditText
            android:id="@+id/etDescription"
            style="@style/InputField"
            android:layout_height="100dp"
            android:layout_marginBottom="24dp"
            android:gravity="top"
            android:hint="Condition, allergens, notes..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="300"
            android:padding="14dp"/>

        <TextView
            android:id="@+id/btnPublish"
            style="@style/PrimaryButton"
            android:layout_marginBottom="20dp"
            android:text="Publish Listing"/>

    </LinearLayout>
</ScrollView>
