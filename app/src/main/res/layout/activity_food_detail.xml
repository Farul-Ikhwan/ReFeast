<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="14dp"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="22sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Listing Details"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivImage"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_margin="16dp"
                android:background="@drawable/bg_food_placeholder"
                android:contentDescription="Food photo"
                android:scaleType="center"
                android:src="@drawable/ic_food"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unsold Bread Loaves"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvDonor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Donated by Sweet Crumb Bakery"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvStatus"
                    style="@style/ChipText"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_chip_delivered"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Available"
                    android:textSize="12sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/divider"/>

                <TextView style="@style/InfoLabel" android:text="Quantity"/>
                <TextView android:id="@+id/tvQuantity" style="@style/InfoValue" android:text="10 of 10 loaves left"/>

                <TextView style="@style/InfoLabel" android:text="Category"/>
                <TextView android:id="@+id/tvCategory" style="@style/InfoValue" android:text="Baked Goods"/>

                <TextView style="@style/InfoLabel" android:text="Pickup Location"/>
                <TextView android:id="@+id/tvLocation" style="@style/InfoValue" android:text="Jalan Bahagia, Petaling Jaya"/>

                <TextView style="@style/InfoLabel" android:text="Pickup Deadline"/>
                <TextView android:id="@+id/tvExpiry" style="@style/InfoValue" android:text="Today, 10:00 PM"/>

                <TextView style="@style/InfoLabel" android:text="Description"/>
                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/InfoValue"
                    android:layout_marginBottom="20dp"
                    android:text="Description"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:text="Info"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone"/>

                <!-- Donor only: reservations made on this listing -->
                <TextView
                    android:id="@+id/tvReservationsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Reservations"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReservations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <TextView
                    android:id="@+id/btnReserve"
                    style="@style/PrimaryButton"
                    android:layout_marginBottom="12dp"
                    android:text="Reserve This Item"/>

                <TextView
                    android:id="@+id/btnWithdraw"
                    style="@style/DangerButton"
                    android:layout_marginBottom="28dp"
                    android:text="Withdraw Listing"
                    android:visibility="gone"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
